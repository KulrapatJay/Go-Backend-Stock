# Local development only. Every value below is a throwaway placeholder for your own machine.
# Production never uses these values or this compose file: it rejects the dev-only- secrets.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:8080
LOG_LEVEL=info
DOCS_ENABLED=true
DOCS_TRY_IT_OUT_ENABLED=true

POSTGRES_DB=stock
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=dev_admin_password
POSTGRES_HOST_PORT=55432

# Letters, digits and underscores only: these are embedded in connection URLs unescaped.
APP_MIGRATOR_PASSWORD=dev_migrator_password
APP_RUNTIME_PASSWORD=dev_runtime_password
APP_MAINTENANCE_PASSWORD=dev_maintenance_password

# Days to keep audit events, 30 to 365; empty means 90. Read only by the maintenance job.
AUDIT_RETENTION_DAYS=

# At least 32 bytes each and all four different. Production rejects anything starting with dev-only-.
CSRF_SECRET=dev-only-csrf-secret-0123456789abcdef
OTP_SECRET=dev-only-otp-secret-0123456789abcdefgh
RATE_LIMIT_SECRET=dev-only-rate-limit-secret-0123456789ab
OIDC_SECRET=dev-only-oidc-secret-0123456789abcdefg

# Leave Google empty to keep Google sign-in off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# demo (default for development) or alpaca; alpaca needs the key and secret of a free Alpaca paper account.
PRICE_PROVIDER=demo
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_TRADING_BASE_URL=
ALPACA_DATA_BASE_URL=
