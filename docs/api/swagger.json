{
    "swagger": "2.0",
    "info": {
        "description": "Records US stock trades and tracks portfolio cost and P\u0026L. It does not place real orders.\nMilestone 1 exposes only the Health endpoints; every other endpoint is not implemented yet.",
        "title": "Stock Portfolio Tracker API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/auth/csrf": {
            "get": {
                "description": "Returns the token to send in the X-CSRF-Token header of every POST. Signed in, the token is bound to the session; signed out, it is bound to a random nonce that this call keeps in the HttpOnly cookie csrf_nonce (__Host-csrf_nonce over HTTPS). Tokens last one hour. Ask for a new token after login and after logout, because the binding changes. Browsers (and Swagger UI) send the cookie by themselves; curl needs a cookie jar (-b/-c).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Get a CSRF token",
                "operationId": "getCSRFToken",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.CSRFResponse"
                        },
                        "headers": {
                            "Set-Cookie": {
                                "type": "string",
                                "description": "csrf_nonce=…; Path=/; HttpOnly; SameSite=Lax — only when signed out"
                            }
                        }
                    },
                    "503": {
                        "description": "dependency_unavailable: the session store could not be reached",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/register": {
            "post": {
                "description": "Creates an unverified account and emails a 6-digit verification code. The answer is the same whether or not the email already has an account: the owner of an existing account gets an email notice instead and nothing changes. The response takes at least about half a second on purpose. Needs the pre-login CSRF flow: call GET /api/v1/auth/csrf first, send its token in X-CSRF-Token, and send the csrf_nonce cookie (a browser does this itself). Then confirm the code with POST /api/v1/auth/email-verification/confirm.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Register with an email and a password",
                "operationId": "register",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Token from GET /api/v1/auth/csrf",
                        "name": "X-CSRF-Token",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Email, and a password of 6-32 printable ASCII characters without spaces, with a lower-case letter, an upper-case letter and a special character",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/http.OTPAcceptedResponse"
                        }
                    },
                    "400": {
                        "description": "invalid_input (details lists every broken password rule) or malformed_json",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "csrf_failed",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "rate_limited; wait Retry-After seconds",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        },
                        "headers": {
                            "Retry-After": {
                                "type": "integer",
                                "description": "Seconds to wait"
                            }
                        }
                    },
                    "503": {
                        "description": "server_busy; wait Retry-After seconds",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        },
                        "headers": {
                            "Retry-After": {
                                "type": "integer",
                                "description": "Seconds to wait"
                            }
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "Returns 200 while the process is running. Does not check the database.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Liveness probe",
                "operationId": "getHealthz",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.HealthResponse"
                        },
                        "headers": {
                            "X-Request-ID": {
                                "type": "string",
                                "description": "Server-generated UUIDv7 for this request"
                            }
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "description": "Pings the database within a 1 second budget. Returns 503 not_ready without connection details when it is unreachable.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Readiness probe",
                "operationId": "getReadyz",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.ReadyResponse"
                        },
                        "headers": {
                            "X-Request-ID": {
                                "type": "string",
                                "description": "Server-generated UUIDv7 for this request"
                            }
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "http.CSRFResponse": {
            "type": "object",
            "properties": {
                "csrf_token": {
                    "type": "string",
                    "example": "AQAAAABnHk3QxJ9b3m0z0bH2l9V1cW5qQk1xU2ZtV0RkY0p0dVhQb0xMZ3hQYnpqUkw"
                },
                "expires_at": {
                    "type": "string",
                    "example": "2026-10-24T10:00:00Z"
                }
            }
        },
        "http.ErrorBody": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "not_found"
                },
                "details": {
                    "description": "Details lists the rules an input broke, such as password_too_short; only on invalid_input.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "password_too_short",
                        "password_missing_special"
                    ]
                },
                "message": {
                    "type": "string",
                    "example": "Not Found"
                },
                "request_id": {
                    "type": "string",
                    "example": "0192f0c1-7a8e-7cc4-9d2b-3f6c1a2b4c5d"
                }
            }
        },
        "http.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/http.ErrorBody"
                }
            }
        },
        "http.HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "http.OTPAcceptedResponse": {
            "type": "object",
            "properties": {
                "challenge_id": {
                    "type": "string",
                    "example": "0192f0c1-7a8e-7cc4-9d2b-3f6c1a2b4c5d"
                },
                "expires_in": {
                    "type": "integer",
                    "example": 600
                },
                "message": {
                    "type": "string",
                    "example": "If this address can receive email, a verification code has been sent. It expires in 10 minutes."
                }
            }
        },
        "http.ReadyResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ready"
                }
            }
        },
        "http.RegisterRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "user@example.com"
                },
                "password": {
                    "type": "string",
                    "example": "Zq9!kVx1"
                }
            }
        }
    },
    "tags": [
        {
            "description": "Liveness and readiness probes",
            "name": "Health"
        },
        {
            "description": "Registration, email verification, sessions and CSRF tokens. Every POST needs the X-CSRF-Token header from GET /api/v1/auth/csrf and must come from the API's own origin.",
            "name": "Auth"
        }
    ]
}