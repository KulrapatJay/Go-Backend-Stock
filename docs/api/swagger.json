{
    "swagger": "2.0",
    "info": {
        "description": "Records US stock trades and tracks portfolio cost and P\u0026L. It does not place real orders.\nMilestone 1 exposes only the Health endpoints; every other endpoint is not implemented yet.",
        "title": "Stock Portfolio Tracker API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/auth/csrf": {
            "get": {
                "description": "Returns the token to send in the X-CSRF-Token header of every POST. Signed in, the token is bound to the session; signed out, it is bound to a random nonce that this call keeps in the HttpOnly cookie csrf_nonce (__Host-csrf_nonce over HTTPS). Tokens last one hour. Ask for a new token after login and after logout, because the binding changes. Browsers (and Swagger UI) send the cookie by themselves; curl needs a cookie jar (-b/-c).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Get a CSRF token",
                "operationId": "getCSRFToken",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.CSRFResponse"
                        },
                        "headers": {
                            "Set-Cookie": {
                                "type": "string",
                                "description": "csrf_nonce=…; Path=/; HttpOnly; SameSite=Lax — only when signed out"
                            }
                        }
                    },
                    "503": {
                        "description": "dependency_unavailable: the session store could not be reached",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "Returns 200 while the process is running. Does not check the database.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Liveness probe",
                "operationId": "getHealthz",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.HealthResponse"
                        },
                        "headers": {
                            "X-Request-ID": {
                                "type": "string",
                                "description": "Server-generated UUIDv7 for this request"
                            }
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "description": "Pings the database within a 1 second budget. Returns 503 not_ready without connection details when it is unreachable.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Readiness probe",
                "operationId": "getReadyz",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.ReadyResponse"
                        },
                        "headers": {
                            "X-Request-ID": {
                                "type": "string",
                                "description": "Server-generated UUIDv7 for this request"
                            }
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/http.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "http.CSRFResponse": {
            "type": "object",
            "properties": {
                "csrf_token": {
                    "type": "string",
                    "example": "AQAAAABnHk3QxJ9b3m0z0bH2l9V1cW5qQk1xU2ZtV0RkY0p0dVhQb0xMZ3hQYnpqUkw"
                },
                "expires_at": {
                    "type": "string",
                    "example": "2026-10-24T10:00:00Z"
                }
            }
        },
        "http.ErrorBody": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "not_found"
                },
                "details": {
                    "description": "Details lists the rules an input broke, such as password_too_short; only on invalid_input.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "password_too_short",
                        "password_missing_special"
                    ]
                },
                "message": {
                    "type": "string",
                    "example": "Not Found"
                },
                "request_id": {
                    "type": "string",
                    "example": "0192f0c1-7a8e-7cc4-9d2b-3f6c1a2b4c5d"
                }
            }
        },
        "http.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/http.ErrorBody"
                }
            }
        },
        "http.HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "http.ReadyResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ready"
                }
            }
        }
    },
    "tags": [
        {
            "description": "Liveness and readiness probes",
            "name": "Health"
        },
        {
            "description": "Registration, email verification, sessions and CSRF tokens. Every POST needs the X-CSRF-Token header from GET /api/v1/auth/csrf and must come from the API's own origin.",
            "name": "Auth"
        }
    ]
}